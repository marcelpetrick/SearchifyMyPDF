#
# Reproducible build environment for the Linux one-file executable.
# Ubuntu 22.04 sets the glibc baseline (2.35) and supplies Leptonica. Tesseract is built
# from a pinned, checksum-verified source release without libarchive, libcurl, training
# tools or OpenMP: Ubuntu's package links libarchive → libxml2 → a second ICU (≈ 12 MB
# packed) that Searchify never uses. OCRmyPDF runs one Tesseract per page anyway, so
# OpenMP threads would only oversubscribe the CPU (PLAN step 27).
FROM ubuntu:22.04 AS tesseract
ARG TESSERACT_VERSION=5.5.4
ARG TESSERACT_SHA256=a8dbf8b8c8ee427ff6ad1d99116502feaf59440af1adb893caf60a6576826cf4
RUN apt-get -o Acquire::Retries=5 update && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
        ca-certificates curl build-essential autoconf automake libtool pkg-config \
        libleptonica-dev \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /tmp/tesseract.tar.gz \
        "https://github.com/tesseract-ocr/tesseract/archive/refs/tags/${TESSERACT_VERSION}.tar.gz" \
    && echo "${TESSERACT_SHA256}  /tmp/tesseract.tar.gz" | sha256sum -c - \
    && tar -C /tmp -xzf /tmp/tesseract.tar.gz \
    && cd "/tmp/tesseract-${TESSERACT_VERSION}" \
    && ./autogen.sh >/dev/null \
    && ./configure --prefix=/usr/local --disable-openmp --disable-training --disable-doc \
        --without-archive --without-curl --disable-static --disable-debug \
        CXXFLAGS="-O2" >/dev/null \
    && make -j"$(nproc)" >/dev/null \
    && make install-strip DESTDIR=/stage >/dev/null \
    && install -Dm644 LICENSE /stage/usr/local/share/doc/tesseract/LICENSE \
    && echo "${TESSERACT_VERSION}" > /stage/usr/local/share/doc/tesseract/VERSION \
    && rm -rf /stage/usr/local/share/tessdata /stage/usr/local/include /stage/usr/local/lib/pkgconfig

# Trimmed ICU 73.2 data for the bundled Qt (en/de UI), see build_icu_data.sh (PLAN step 28).
FROM ubuntu:22.04 AS icu
RUN apt-get -o Acquire::Retries=5 update && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
        ca-certificates curl build-essential python3 unzip \
    && rm -rf /var/lib/apt/lists/*
COPY build_icu_data.sh icu-data-filter.json /icu/
RUN mkdir -p /icu/src && cd /icu/src \
    && for f in icu4c-73_2-src.tgz icu4c-73_2-data.zip; do \
        curl -fsSL -o "$f" "https://github.com/unicode-org/icu/releases/download/release-73-2/$f"; \
    done \
    && /icu/build_icu_data.sh /icu/src /opt/icu-data \
    && rm -rf /icu/src

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=0

RUN apt-get -o Acquire::Retries=5 update && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
        liblept5 binutils file ca-certificates curl \
        libegl1 libgl1 libxkbcommon0 libxkbcommon-x11-0 libfontconfig1 libfreetype6 \
        libdbus-1-3 libglib2.0-0 libxcb-cursor0 libxcb-icccm4 libxcb-keysyms1 \
        libxcb-shape0 libxcb-xinerama0 libxcb-randr0 libxcb-render-util0 libxcb-image0 \
        libxcb-xkb1 libx11-xcb1 libwayland-client0 libwayland-cursor0 libwayland-egl1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=tesseract /stage/usr/local/ /usr/local/
COPY --from=icu /opt/icu-data/ /opt/icu-data/
RUN ldconfig && tesseract --version

COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /usr/local/bin/uv
RUN uv python install 3.12
WORKDIR /work
